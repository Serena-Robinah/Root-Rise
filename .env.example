# Backend Configuration
NODE_ENV=development
PORT=3000
DB_PATH=database.db
JWT_SECRET=root-and-rise-secret-key

# Frontend
REACT_APP_API_URL=http://localhost:3000

# Google OAuth
# Backend: used by server-side verification (if needed)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Frontend (Vite): client ID exposed to browser for Google Sign-In
# Copy this value into frontend/.env or set VITE_GOOGLE_CLIENT_ID in your frontend environment

# Optional: Gemini API (if using AI features)
# GEMINI_API_KEY=your_key_here

